url = {https://doi.org/10.1145/3797867.3829030},
doi = {10.1145/3797867.3829030},
abstract = {Data visualizations are vital for communication and decision-making, yet accessibility barriers limit their effectiveness for people with disabilities. While earlier literature reviews examined Human-Computer Interaction (HCI) research on visualization accessibility, there has not been an analysis that accounts for recent seismic shifts in software, hardware, design and experimental protocols due to Artificial Intelligence (AI), the COVID-19 pandemic, and greater awareness of accessible technologies. To analyze the impacts of this shift on accessible visualization research, we reviewed 280&nbsp;HCI publications and coded target communities, visualization types, interaction types, and methods, contrasting articles published before and after 2021. Our corpus identified a sharp increase in publications after 2021 along with an expansion to a broader range of target communities, including people with CVD, IDD, and ADHD. Empirical and artifact contributions still dominate, with studies after 2021 showing a higher proportion of empirical studies. Participatory approaches are increasing but still remain limited. Research mainly focuses on charts and web-based, text-driven interactions, with articles after 2021 indicating a growing interest in multimodal and AI-driven systems. We further dissect this recent surge, positioning it against earlier work to identify trends, limitations, and open questions to guide future research.},
booktitle = {Proceedings of the 28th International ACM SIGACCESS Conference on Computers and Accessibility},
articleno = {19},
numpages = {25},
keywords = {Literature Review, Survey, Accessibility, Data Visualization},
location = {Porto, Portugal},
series = {ASSETS '26}
}
