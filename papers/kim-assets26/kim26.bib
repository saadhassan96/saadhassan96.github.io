keywords = {Sign Language, American Sign Language, Language Learning, Sign Language Learning, Artificial Intelligence, Sign Language Recognition, Sign Language Segmentation, Human-AI Interaction, Video Comprehension},
location = {Porto, Portugal},
series = {ASSETS '26}
}
