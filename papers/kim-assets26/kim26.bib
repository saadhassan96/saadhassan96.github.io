doi = {10.1145/3797867.3828986},
abstract = {Sign language learners often watch continuous signing videos to develop their receptive and expressive skills, yet looking up and identifying unfamiliar signs during these comprehension tasks remains a challenge. Prior HCI research has explored in-situ sign lookup tools using Wizard-of-Oz prototypes, enabling learners to search for signs by submitting video segments as queries. Findings showed that this approach improved comprehension and reduced cognitive load compared to feature-based dictionaries. Building on advances in AI-based sign language recognition and segmentation, we present an automatic video comprehension prototype system that segments continuous signing into individual signs and employs a fine-tuned recognition model to retrieve the closest matches for each segment. We report findings from an experimental study with thirteen intermediate ASL learners, combining quantitative and observational analyses to compare our system with a baseline that supports user-selected segment-based search but lacks AI-based automatic segmentation. Results show that automatic segmentation improved user experience, while observational data revealed distinct interaction patterns between the two prototype systems. We release both prototype systems and present design guidelines for video comprehension tools for sign language learners.},
booktitle = {Proceedings of the 28th International ACM SIGACCESS Conference on Computers and Accessibility},
